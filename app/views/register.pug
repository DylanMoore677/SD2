//- Registration page for both students and societies (admins).
//- Uses a segmented control to switch between the two registration forms.
//- defaultRegistrationRole determines which panel is shown first.
extends layout
include includes/ui.pug

block pageVars
  //- Registration lives outside the authenticated student/admin shells.
  - var pageRole = "student"
  - var headerRoleLabel = null
  - var navLinks = []
  - var logoPath = "/"

block content
  //- Shared public-route fallbacks allow this template to compile for app routes and previews.
  - var defaultRegistrationRole = typeof defaultRegistrationRole !== "undefined" ? defaultRegistrationRole : "student";
  - var loginPath = typeof loginPath !== "undefined" ? loginPath : "/login";
  - var guestPath = typeof guestPath !== "undefined" ? guestPath : "/demo/guest/";
  - var studentHomePath = typeof studentHomePath !== "undefined" ? studentHomePath : "/demo/student/";
  - var adminHomePath = typeof adminHomePath !== "undefined" ? adminHomePath : "/demo/admin/";

  section.section-block(data-role-switcher data-default-role=defaultRegistrationRole)
    .auth-layout
      section.form-shell.auth-main-card
        .segmented-controls.auth-switch
          button.role-tab(type="button" data-role-target="student") Register as Student
          button.role-tab(type="button" data-role-target="admin") Register as Admin

        //- Student registration writes to the Student table through POST /register.
        section.auth-panel(data-role-panel="student")
          .section-heading
            p.eyebrow Student Registration
            h2 Create your student account
            p Fill in your details to create a student account.
          if typeof registerError !== "undefined" && registerError && defaultRegistrationRole === "student"
            p.form-error= registerError
          form.form-stack(method="post", action="/register")
            +formInput("student-email", "Email", "email", "Enter your university email", null, "email", true)
            +formInput("student-first-name", "First Name", "text", "Enter your first name", null, "first_name", true)
            +formInput("student-last-name", "Last Name", "text", "Enter your last name", null, "last_name", true)
            +formInput("student-password", "Password", "password", "Create a password", null, "password", true)
            .btn-row
              button.btn.btn-primary(type="submit") Create Student Account
              a.btn.btn-outline(href=loginPath) Back to Login

        //- Admin registration creates a Society record through POST /register/admin.
        section.auth-panel(data-role-panel="admin" hidden)
          .section-heading
            p.eyebrow Society Registration
            h2 Register a society
            p Register your society to start posting and managing members.
          if typeof registerError !== "undefined" && registerError && defaultRegistrationRole === "admin"
            p.form-error= registerError
          form.form-stack(method="post", action="/register/admin")
            +formInput("society-name", "Society Name", "text", "Enter the society name", null, "name", true)
            +formInput("society-email", "Email", "email", "Enter the society email", null, "email", true)
            +formTextarea("society-description", "About the Society", "Write a short society description", null, "about_us_text", true)
            +formInput("society-password", "Password", "password", "Create a password", null, "password", true)
            .btn-row
              button.btn.btn-primary(type="submit") Register Society
              a.btn.btn-outline(href=loginPath) Back to Login

