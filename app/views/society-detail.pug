extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "student"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Student"
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/student/"
  - var studentBasePath = logoPath.replace(/\/$/, "")
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Home", href: studentBasePath + "/", exact: true }, { label: "Societies", href: studentBasePath + "/societies/" }, { label: "News", href: studentBasePath + "/feed/" }, { label: "Profile", href: studentBasePath + "/profile/1/", icon: "profile" }]

block content
  - var societiesBasePath = typeof societiesBasePath !== "undefined" ? societiesBasePath : studentBasePath + "/societies";
  - var recentUpdates = typeof societyUpdates !== 'undefined' ? societyUpdates : [];
  - var isMember = typeof isMember !== "undefined" ? isMember : false;
  - var rsvpBase = typeof rsvpBase !== "undefined" ? rsvpBase : "/student/rsvp";
  - var formatSocietyName = function(email) {
  -   var localPart = email ? email.split("@")[0] : "society";
  -   var words = localPart.split(/[._-]/).filter(Boolean).map(function(word) {
  -     return word.charAt(0).toUpperCase() + word.slice(1);
  -   });
  -   return (words.join(" ") || "Society") + " Society";
  - };
  - var societyName = formatSocietyName(society && society.email);
  - var memberCount = members ? members.length : 0;

  +pageHeader(societyName)

  section.section-block
    .society-hero-grid
      section.section-card
        .section-heading
          p.eyebrow Society Information
          h2 About this society
          if society && society.email
            p.society-contact-email Contact email: #{society.email}
          p= society && society.about_us_text ? society.about_us_text : "More society information will appear here when it becomes available."

      aside.sidebar-stack
        section.section-card
          .section-heading
            p.eyebrow Membership
            h2= isMember ? "You are a member" : "Ready to join?"
            p= isMember ? "Click below to leave this society." : "Become a member to follow this society's posts and events."
          .btn-row
            if isMember && typeof leavePath !== "undefined" && leavePath
              form(method="post", action=leavePath)
                button.btn.btn-soft(type="submit") Leave Society
            else if typeof joinPath !== "undefined" && joinPath
              form(method="post", action=joinPath)
                button.btn.btn-primary(type="submit") Join Society
            else
              button.btn.btn-primary(type="button") Join Society

  section.section-block
    .section-heading
      p.eyebrow Society Posts
      h2 Latest posts and updates
    .card-grid.news-grid
      if recentUpdates.length
        each item in recentUpdates
          article.event-card.news-card
            p.card-kicker= item.type || "Update"
            h3.card-title= item.title || "Society post"
            p.card-text= item.content || item.description || "More post detail will appear here when content is available."
            p.feed-meta= item.created_at || item.event_date || "Recent update"
            if isMember && (item.type === "Event" || item.type === "event") && item.post_id
              form(method="post", action=rsvpBase + "/" + item.post_id)
                button.btn.btn-outline(type="submit")= item.rsvped ? "Remove RSVP" : "RSVP"
      else
        article.event-card.news-card
          p.card-kicker Announcement
          h3.card-title Society posts will appear here
          p.card-text This section is ready for posts, event updates, and announcements from the society.
