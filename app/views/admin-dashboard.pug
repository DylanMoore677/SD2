//- Admin post dashboard — lists all posts and events for the society.
//- Each card shows the post type, title, content, date, an Edit link, a Delete button,
//- and an RSVP count badge for event posts.
extends layout
include includes/ui.pug

block pageVars
  //- Admin nav fallback for live, demo, and preview organiser contexts.
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  //- Normalise counts and post arrays so the same template works with live DB data and previews.
  - var postsCount = typeof postsCount !== "undefined" ? postsCount : 12;
  - var eventsCount = typeof eventsCount !== "undefined" ? eventsCount : 4;
  - var membersCount = typeof membersCount !== "undefined" ? membersCount : 38;
  - var rsvpCount = typeof rsvpCount !== "undefined" ? rsvpCount : 16;
  - var postItems = typeof postItems !== "undefined" ? postItems : [];
  - var createPostPath = typeof createPostPath !== "undefined" ? createPostPath : "/demo/admin/create-post/";
  - var manageSocietyPath = typeof manageSocietyPath !== "undefined" ? manageSocietyPath : "/demo/admin/manage-society/";

  +pageHeader("Post Dashboard", "Review your society posts and event content.", "Admin Dashboard")

  section.section-block
    .dashboard-main
        section.section-card#content-queue
          .section-heading
            p.eyebrow Society Content
            h2 Posts and event items in view
            p View, edit, and delete your society's posts and events.
          //- Each card mirrors one real post/event row and exposes the matching admin actions.
          if postItems.length
            .feed-stack
              each item in postItems
                article.management-card.feed-card
                  p.card-kicker= item.type || "Post"
                  h3.card-title= item.title || "Untitled"
                  p.card-text= item.description || ""
                  p.feed-meta= item.created_at
                  .btn-row
                    a.btn.btn-outline(href="/admin/posts/" + item.post_id + "/edit") Edit
                    form(method="post", action="/admin/posts/" + item.post_id + "/delete")
                      button.btn.btn-danger(type="submit") Delete
                    if item.rsvp_count !== null && item.rsvp_count !== undefined
                      span.post-rsvp-badge #{item.rsvp_count} RSVP#{item.rsvp_count === 1 ? "" : "s"}
          else
            +emptyState("Society content will appear here", "Use the dashboard to create new posts, then manage them from this queue.")
