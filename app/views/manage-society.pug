extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var formatSocietyName = function(email) {
  -   var localPart = email ? email.split("@")[0] : "society";
  -   var words = localPart.split(/[._-]/).filter(Boolean).map(function(word) {
  -     return word.charAt(0).toUpperCase() + word.slice(1);
  -   });
  -   return (words.join(" ") || "Society") + " Society";
  - };
  - var societyName = society && society.email ? formatSocietyName(society.email) : "Managed Society";
  - var membersList = typeof members !== "undefined" ? members : [];
  - var eventItems = typeof eventItems !== "undefined" ? eventItems : [];
  - var dashboardPath = typeof dashboardPath !== "undefined" ? dashboardPath : "/demo/admin/";

  +pageHeader("Manage Society", "Update the society profile, review members, and keep event information organised inside one structured organiser page.", societyName)
    a.btn.btn-outline(href=dashboardPath) Back to Dashboard

  section.section-block
    +dashboardLayout()
      +dashboardSidebar("Management Sections", "Keep society details, membership, events, and the delete action clearly separated.")
        +dashboardNav([
          { label: "Society Details", href: "#society-details", active: true },
          { label: "Members", href: "#members" },
          { label: "Events", href: "#events" },
          { label: "Danger Zone", href: "#danger-zone" }
        ])

      main.dashboard-main
        section.form-shell#society-details
          .section-heading
            p.eyebrow Society Details
            h2 Update the society profile
            p Keep the core society information in one clean management form.
          form.form-stack
            +formInput("society-name", "Society Name", "text", "Enter the society name", societyName)
            +formTextarea("society-description", "Society Description", "Write the society description", society && society.about_us_text ? society.about_us_text : "")
            .btn-row
              button.btn.btn-primary(type="button") Update

        section.section-card#members
          .section-heading
            p.eyebrow Members
            h2 Members in this society
            p Keep the member information grouped beneath the profile form so organisers can review who is part of the society.
          if membersList.length
            .data-table
              .data-row.data-row-header
                span Name
                span Email
                span Remove
              each member in membersList
                .data-row
                  span #{member.first_name} #{member.last_name}
                  span= member.email
                  span
                    form(method="post", action="/admin/manage-society/members/" + member.student_id + "/remove")
                      button.btn.btn-danger.btn-small(type="submit") Remove
          else
            +emptyState("No members yet", "Member records will appear here once data is available.")

        section.section-card#events
          .section-heading
            p.eyebrow Events
            h2 Events connected to the society
            p Show society events in a management view rather than a browse layout.
          if eventItems.length
            .feed-stack
              each item in eventItems
                article.management-card.feed-card
                  p.card-kicker Event
                  h3.card-title= item.title || "Society event"
                  p.card-text= item.description || "Event information will appear here."
                  p.feed-meta= item.event_date || "Upcoming event"
          else
            +emptyState("No events yet", "Event records will appear here once society events are available.")

        section.section-card.danger-zone#danger-zone
          .section-heading
            p.eyebrow Delete Society
            h2 Remove this society
            p Keep destructive actions isolated at the bottom of the page so the organiser flow stays structured and clear.
          button.btn.btn-danger(type="button") Delete Society
