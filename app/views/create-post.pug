extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var dashboardPath = typeof dashboardPath !== "undefined" ? dashboardPath : "/demo/admin/";

  +pageHeader("Create New Post", "Create a society update using a simple organiser form with only the fields needed for the post itself.", "Post Creation")
    a.btn.btn-outline(href=dashboardPath) Back to Dashboard

  section.section-block
    .split-layout
      section.form-shell
        .section-heading
          p.eyebrow Post Form
          h2 Create a new society post
          p Keep the post form clean and practical for organisers.
        form.form-stack
          +formInput("post-title", "Title", "text", "Enter the post title")
          +formTextarea("post-description", "Description", "Write the post description")
          +formInput("rsvp-date", "RSVP Date", "text", "Add an RSVP date")
          .btn-row
            button.btn.btn-primary(type="button") Create Post

      aside.sidebar-stack
        section.section-card
          .section-heading
            p.eyebrow Guidance
            h2 What to include
            p Keep the information focused so students can read it quickly once it appears in the feed.
          .flow-grid
            +flowStep("1", "Write a clear title", "Use a short, specific title that matches the announcement or event.")
            +flowStep("2", "Add the main detail", "Put the essential description in the post body.")
            +flowStep("3", "Set the RSVP date", "Keep the deadline visible if students need to respond.")
