//- Shared content building blocks for the live routed pages.
mixin statCard(value, label, helper)
  article.stat-card
    p.stat-label= label
    p.stat-value= value
    if helper
      p.stat-helper= helper

mixin flowStep(number, title, body)
  article.flow-step
    span.flow-step-number= number
    div
      h3= title
      p= body

mixin emptyState(title, body)
  section.empty-state
    h3.card-title= title
    p.card-text= body

mixin pageHeader(title, subtitle, eyebrow)
  header.page-header
    if eyebrow
      p.eyebrow= eyebrow
    h1.page-title= title
    if subtitle
      p.page-subtitle= subtitle
    if block
      .btn-row
        block

mixin cardGrid(columns)
  - var gridClass = columns ? "cols-" + columns : "";
  .card-grid(class=gridClass)
    if block
      block

mixin sharedCard(type, kicker, title, body, tone)
  - var cardType = type || "info-card";
  article(class=cardType + (tone ? " is-" + tone : ""))
    if kicker
      p.card-kicker= kicker
    if title
      h3.card-title= title
    if body
      p.card-text= body
    if block
      .card-actions
        block

mixin dashboardLayout()
  .dashboard-layout
    if block
      block

mixin dashboardSidebar(title, body)
  aside.dashboard-sidebar
    if title
      h3.card-title= title
    if body
      p.card-text= body
    if block
      block

mixin dashboardNav(items)
  nav.dashboard-nav
    each item in items
      a(href=item.href, class=item.active ? "is-active" : false)= item.label

//- Auth and form helpers stay in one place so login/register previews and routes share markup.
mixin authLoginEntry(studentHomePath, adminHomePath, guestPath, registerPath, adminRegisterPath, defaultRole)
  - var initialRole = defaultRole || "student"
  section.section-block.auth-login-section
    .auth-layout.auth-login-layout(
      data-login-root
      data-default-role=initialRole
      data-student-path="/login"
      data-admin-path="/login"
      data-student-register-path=registerPath
      data-admin-register-path=adminRegisterPath || registerPath
    )
      section.form-shell.auth-main-card.auth-login-card
        .section-heading.auth-login-heading
          h2 Login
        if typeof loginError !== "undefined" && loginError
          p.form-error Incorrect email or password. Please try again.
        form.form-stack(method="post", action="/login", data-login-form)
          input(type="hidden", name="role", value=initialRole, data-login-role-input)
          .form-group.auth-role-picker
            label Login as
            .segmented-controls.auth-switch
              button.role-tab(type="button", data-login-role="student") Student
              button.role-tab(type="button", data-login-role="admin") Admin
          p.auth-role-copy(data-login-copy) Student access opens your profile, societies, and news feed.
          +formInput("login-email", "Email", "email", "Enter your email", null, "email")
          +formInput("login-password", "Password", "password", "Enter your password", null, "password")
          .btn-row.auth-login-actions
            button.btn.btn-primary(type="submit") Login
            a.btn.btn-outline(
              href=registerPath
              data-login-register
              data-student-register-label="Register"
              data-admin-register-label="Register a Society"
            ) Register
      section.section-card.auth-login-support
        .section-heading.auth-support-heading
          h3 Welcome to Society Hub
          p Sign in to continue to the platform.
        .auth-support-list
          article.auth-support-item
            p.card-kicker Student
            p.card-text Discover societies, keep up with updates, and manage your profile from one student space.
          article.auth-support-item
            p.card-kicker Admin
            p.card-text Open the organiser dashboard to manage posts, members, events, and society details.

mixin formInput(id, label, type, placeholder, value, name)
  .form-group
    label(for=id)= label
    input.form-input(id=id, name=name || id, type=type || "text", placeholder=placeholder, value=value || "")

mixin formTextarea(id, label, placeholder, value, name)
  .form-group
    label(for=id)= label
    textarea.form-textarea(id=id, name=name || id, placeholder=placeholder)= value || ""

mixin statsGrid()
  .stats-grid
    if block
      block
