//- Society directory — lists all societies with a live search filter.
//- Search is handled client-side via the data-filter-* attributes and site.js.
extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "student"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Student"
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/student/"
  - var studentBasePath = logoPath.replace(/\/$/, "")
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Home", href: studentBasePath + "/", exact: true }, { label: "Societies", href: studentBasePath + "/societies/" }, { label: "News", href: studentBasePath + "/feed/" }, { label: "Profile", href: studentBasePath + "/profile/1/", icon: "profile" }]

block content
  - var societies = typeof societies !== "undefined" ? societies : [];
  - var listBasePath = societyBasePath || "/preview/societies";

  header.page-header.societies-page-header
    h1.page-title All Societies
    p.page-subtitle Browse student communities, discover new interests, and open a society to learn more.

  section.section-block.societies-search-section(data-filter-root data-query-param="q")
    .form-shell.search-shell.societies-search-shell
      p.societies-search-label Search societies
      .societies-search-row
        .societies-search-field
          input#society-search.form-input(type="search", name="q", placeholder="Search by society name" data-filter-input)
        button.btn.btn-primary.societies-search-button(type="button" data-filter-trigger) Search
      p.helper-text.societies-search-count Showing #[span(data-filter-count)= societies.length] of #{societies.length} societies

    .card-grid.society-directory-grid.student-society-grid
      each society in societies
        - var societyName = society.name || "Society";
        - var searchText = [societyName, society.email, society.about_us_text, society.tags, society.categories, society.tag_list].filter(Boolean).join(" ");
        - var imageUrl = society.logo_url || "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&q=80";
        article.society-card.student-society-card(data-filter-item data-search-text=searchText)
          .society-card-image
            img(src=imageUrl alt=societyName onerror="this.src='https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&q=80'")
          .student-society-card-body
            p.card-kicker Society
            h3.card-title= societyName
            if society.about_us_text
              p.society-card-desc= society.about_us_text
            a.btn.btn-primary.student-society-link(href=listBasePath + "/" + society.society_id) View Society

    div(hidden data-filter-empty)
      +emptyState("No societies matched your search", "Try another keyword to bring more societies back into view.")