extends layout

block content
  div.profile-container
    h1 All Societies

    div.search-bar
      input(type="text", placeholder="Search societies...")
      button.btn Search

    each society in societies
      div.society-card
        h2= society.email
        p= society.about_us_text
        a.btn(href="/preview/societies/" + society.society_id) View Society
        button.btn Join Society