//- Members page — lists all students who have joined the society.
//- Includes a live search filter (name or email) powered by data-filter-* and site.js.
//- Each row has a Remove button that posts to /admin/manage-society/members/:id/remove.
extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var membersList = typeof members !== "undefined" ? members : [];
  - var dashboardPath = typeof dashboardPath !== "undefined" ? dashboardPath : "/demo/admin/";

  +pageHeader("Members", "Review and manage students who have joined your society.", "Admin")

  section.section-block(data-filter-root)
    section.section-card
      .section-heading
        p.eyebrow Members
        h2 Members in this society
      .form-group
        label(for="member-search") Search members
        input#member-search.form-input(type="search", placeholder="Search by name or email" data-filter-input)
      if membersList.length
        p.helper-text Showing #[span(data-filter-count)= membersList.length] of #{membersList.length} members
        .data-table.members-table
          .data-row.data-row-header
            span Name
            span Email
            span
          each member in membersList
            - var searchText = [member.first_name, member.last_name, member.email].filter(Boolean).join(" ")
            .data-row(data-filter-item data-search-text=searchText)
              span #{member.first_name} #{member.last_name}
              span= member.email
              span.members-table-action
                form(method="post", action="/admin/manage-society/members/" + member.student_id + "/remove")
                  button.btn.btn-danger.btn-small(type="submit") Remove
        div(hidden data-filter-empty)
          +emptyState("No members matched your search", "Try a different name or email address.")
      else
        +emptyState("No members yet", "Students who join your society will appear here.")
