//- Master layout extended by every page template.
//- Renders the site shell: header with nav, main content area, and footer.
//- Expects pageRole, navLinks, logoPath, and headerRoleLabel to be set in each extending template.
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Society Hub
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap")
    link(rel="stylesheet", href="/style.css")
  block pageVars
  body(class=typeof pageRole !== "undefined" ? "role-" + pageRole : false)
    - var defaultNavLinks = [{ label: "Home", href: "/", exact: true }, { label: "Societies", href: "/preview/societies" }, { label: "About", href: "/about" }, { label: "Login", href: "/login" }];
    - var currentNavLinks = typeof navLinks !== "undefined" && navLinks ? navLinks : defaultNavLinks;
    - var currentLogoPath = typeof logoPath !== "undefined" && logoPath ? logoPath : "/";
    .page-shell.site-shell(class=typeof pageRole !== "undefined" ? pageRole + "-shell" : false)
      header.site-header
        .page-container
          nav.navbar(aria-label="Primary navigation")
            a.logo(href=currentLogoPath)
              if typeof headerRoleLabel !== "undefined" && headerRoleLabel
                span.logo-role= headerRoleLabel
              span.logo-name Society Hub
            if currentNavLinks && currentNavLinks.length
              .nav-groups
                ul.nav-links(class=pageRole === "student" ? "nav-pill-bar" : false)
                  each item in currentNavLinks
                    li
                      a(
                        href=item.href
                        class=item.icon === "profile" ? "is-profile-link" : false
                        aria-label=item.icon === "profile" ? item.label : false
                        data-nav-exact=item.exact ? "true" : false
                      )
                        if item.icon === "profile"
                          span= item.label
                          span.nav-profile-glyph(aria-hidden="true")
                        else
                          = item.label
      main.content
        .page-container.content-stack
          block content
      footer.footer.site-footer
        .page-container
          p Society Hub — your university society platform.
    script(src="/site.js")