extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var postsCount = typeof postsCount !== "undefined" ? postsCount : 12;
  - var eventsCount = typeof eventsCount !== "undefined" ? eventsCount : 4;
  - var membersCount = typeof membersCount !== "undefined" ? membersCount : 38;
  - var rsvpCount = typeof rsvpCount !== "undefined" ? rsvpCount : 16;
  - var postItems = typeof postItems !== "undefined" ? postItems : [];
  - var createPostPath = typeof createPostPath !== "undefined" ? createPostPath : "/demo/admin/create-post/";
  - var manageSocietyPath = typeof manageSocietyPath !== "undefined" ? manageSocietyPath : "/demo/admin/manage-society/";

  +pageHeader("Society Dashboard", "Use the organiser control panel to create new posts, review existing content, and keep the society structured around practical management tasks.", "Admin Dashboard")
    a.btn.btn-primary(href=createPostPath) Create Post
    a.btn.btn-outline(href=manageSocietyPath) Manage Society

  section.section-block
    +dashboardLayout()
      +dashboardSidebar("Control Panel", "Keep creation, editing, deletion, and society management grouped into a clear organiser workspace.")
        +dashboardNav([
          { label: "Overview", href: "#overview", active: true },
          { label: "Post Actions", href: "#post-actions" },
          { label: "Content Queue", href: "#content-queue" }
        ])
        .tag-stack
          h3 Main tools
          .tag-list
            span.tag Create
            span.tag Edit
            span.tag Delete
            span.tag Manage

      main.dashboard-main
        section.section-card#overview
          .section-heading
            p.eyebrow Dashboard Overview
            h2 Society activity at a glance
            p Keep the headline numbers visible before moving into the post management actions.
          +statsGrid
            +statCard(postsCount, "Posts", "Track published and draft content.")
            +statCard(eventsCount, "Events", "Keep upcoming activity close to the dashboard.")
            +statCard(membersCount, "Members", "Monitor the size of the society.")
            +statCard(rsvpCount, "RSVPs", "Review attendance signals quickly.")

        section.section-card#post-actions
          .section-heading
            p.eyebrow Post Actions
            h2 Create, edit, or delete posts
            p The organiser home should feel like a management system, not a browse page.
          +cardGrid(3)
            +sharedCard("management-card", "Create", "Create Post", "Open the clean post form and publish a new society update.")
              a.btn.btn-outline(href=createPostPath) Create Post
            +sharedCard("management-card", "Edit", "Edit Post", "Review existing society content and update the details when something changes.")
              a.btn.btn-outline(href="#content-queue") Edit Posts
            +sharedCard("management-card", "Delete", "Delete Post", "Remove outdated or incorrect content from the society feed when needed.")
              a.btn.btn-outline(href="#content-queue") Delete Posts

        section.section-card#content-queue
          .section-heading
            p.eyebrow Society Content
            h2 Posts and event items in view
            p Show the existing content in a practical queue so organisers can see what is currently live.
          if postItems.length
            .feed-stack
              each item in postItems
                article.management-card.feed-card
                  p.card-kicker= item.type || "Post"
                  h3.card-title= item.title || "Society content"
                  p.card-text= item.description || "Current society content appears here."
                  .btn-row
                    a.btn.btn-outline(href=manageSocietyPath + "#content-queue") Edit
                    button.btn.btn-danger(type="button") Delete
          else
            +emptyState("Society content will appear here", "Use the dashboard to create new posts, then manage them from this queue.")
