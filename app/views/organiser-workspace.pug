extends layout
include includes/ui.pug

block content
  - var memberList = typeof members !== 'undefined' ? members : [];
  - var rsvpItems = typeof rsvpItems !== 'undefined' ? rsvpItems : [];
  - var draftItems = typeof draftItems !== 'undefined' ? draftItems : [];

  +pageHeader("Society Management Workspace", "Use one organiser workspace for drafting announcements, planning events, preparing polls, and reviewing the members who will see them.", "Admin / Organiser")
    a.btn.btn-primary(href="/preview/users") Review Members
    a.btn.btn-outline(href="/login") Back to Organiser Access

  section.section-block
    +dashboardLayout()
      +dashboardSidebar("Workspace Navigation", "This organiser workspace template groups the main management tasks into one dashboard-style page.")
        +dashboardNav([
          { label: "Drafting", href: "#drafting", active: true },
          { label: "Events", href: "#events" },
          { label: "Polls", href: "#polls" },
          { label: "RSVP", href: "#rsvp" },
          { label: "Members", href: "#members" }
        ])

      main.dashboard-main
        section.form-shell#drafting
          .section-heading
            p.eyebrow Drafting
            h2 Start a new organiser post
            p Keep draft tools in a dashboard-friendly shell so organisers can move quickly between different content types.
          form.form-stack
            +formInput("draft-title", "Post title", "text", "Enter a post title")
            .form-group
              label(for="draft-type") Post type
              select#draft-type.form-select
                option Announcement
                option Event
                option Poll
            +formTextarea("draft-content", "Description", "Add the main content for this organiser post")
            .btn-row
              button.btn.btn-primary(type="button") Save Draft
              button.btn.btn-outline(type="button") Preview

        section.section-card#events
          .section-heading
            p.eyebrow Event Planning
            h2 Event management tools
            p Organisers can keep event preparation alongside the rest of the workspace instead of jumping between unrelated pages.
          +cardGrid(3)
            +sharedCard("management-card", "Schedule", "Create event details", "Set event titles, dates, locations, and descriptions in a future connected organiser flow.")
            +sharedCard("management-card", "Attendance", "Review RSVP plans", "Stay close to upcoming attendance needs while event posts are being prepared.")
            +sharedCard("management-card", "Publishing", "Send event updates", "Keep event updates tied to the wider organiser publishing workflow.")

        section.section-card#polls
          .section-heading
            p.eyebrow Poll Tools
            h2 Collect opinions from members
            p Poll management can sit beside events and announcements so organisers have one consistent workspace.
          .feed-stack
            if draftItems.length
              each item in draftItems
                article.info-card.feed-card
                  p.card-kicker= item.type || "Draft"
                  h3.card-title= item.title || "Pending organiser draft"
                  p.card-text= item.description || "Additional draft information will appear here when organiser draft data is available."
            else
              article.info-card.feed-card
                p.card-kicker Poll
                h3.card-title Poll drafts will appear here
                p.card-text Open questions, response summaries, and pending polls can all sit in this organiser workspace area.

        section.section-card#rsvp
          .section-heading
            p.eyebrow RSVP Lists
            h2 Prepare to review attendance
            p This section is ready for organiser-facing RSVP lists once event attendance data is passed into the template.
          .feed-stack
            if rsvpItems.length
              each item in rsvpItems
                article.event-card.feed-card
                  p.card-kicker RSVP
                  h3.card-title= item.title || item.student_name || "Attendance record"
                  p.card-text= item.description || item.status || "More attendance information will appear here when RSVP data is available."
                  p.feed-meta= item.event_name || item.event_date || "Event attendance"
            else
              article.event-card.feed-card
                p.card-kicker RSVP
                h3.card-title RSVP lists will appear here
                p.card-text Attendee lists can be reviewed in this section once event and RSVP data is connected.
                p.feed-meta Placeholder content

        section.section-card#members
          .section-heading
            p.eyebrow Members
            h2 Society members in view
            p Keep key member records visible in the same organiser workspace.
          if memberList.length
            .card-grid.cols-2
              each member in memberList
                article.user-card
                  p.card-kicker Member
                  h3.card-title #{member.first_name} #{member.last_name}
                  p.card-text Student ID: #{member.student_id}
                  p.feed-meta= member.email
          else
            +emptyState("Member records will appear here", "Once member data is passed into this workspace template, organisers can review it without leaving the page.")
