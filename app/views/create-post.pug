//- Create post page — lets admins write and publish an announcement or event post.
//- Uses a segmented control to switch between the two post type forms.
//- Shows a success message after a successful submission via ?success=1 redirect.
extends layout
include includes/ui.pug

block pageVars
  //- Admin nav fallback used by both routed and preview versions of this page.
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  //- createPostPath is injected by the live admin route and falls back to the demo route in previews.
  - var dashboardPath = typeof dashboardPath !== "undefined" ? dashboardPath : "/demo/admin/";
  - var createPostPath = typeof createPostPath !== "undefined" ? createPostPath : "/admin/create-post/";
  - var postCreated = typeof postCreated !== "undefined" ? postCreated : false;

  +pageHeader("Create New Post", "Create an announcement or event for your society.", "Post Creation")

  section.section-block
    .split-layout
      section.form-shell
        .section-heading
          p.eyebrow Post Form
          h2 Create a new society post

        if postCreated
          p.form-success Post created successfully.

        section(data-role-switcher data-default-role="announcement")
          .segmented-controls.auth-switch
            button.role-tab(type="button" data-role-target="announcement") Announcement
            button.role-tab(type="button" data-role-target="event") Event

          //- One template serves both post types; the segmented control just swaps the form body.
          section.auth-panel(data-role-panel="announcement")
            form.form-stack(method="post", action=createPostPath)
              input(type="hidden" name="type" value="announcement")
              +formInput("post-title-ann", "Title", "text", "Enter a title...", null, "title")
              +formTextarea("post-content-ann", "Content", "Write your announcement...", null, "content")
              .btn-row
                button.btn.btn-primary(type="submit") Create Announcement

          section.auth-panel(data-role-panel="event" hidden)
            form.form-stack(method="post", action=createPostPath)
              input(type="hidden" name="type" value="event")
              +formInput("post-title-evt", "Title", "text", "Enter a title...", null, "title")
              +formTextarea("post-content-evt", "Content", "Write your event details...", null, "content")
              .btn-row
                button.btn.btn-primary(type="submit") Create Event

      aside.sidebar-stack
        section.section-card
          .section-heading
            p.eyebrow Guidance
            h2 What to include
            p Keep the information focused so students can read it quickly once it appears in the feed.
          .flow-grid
            +flowStep("1", "Choose post type", "Select Announcement for general news or Event for something students can attend.")
            +flowStep("2", "Write the content", "Give the post a title, then write the full content in the body below.")
