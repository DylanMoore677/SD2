//- Manage society page — three sections:
//- 1. Society Details form: update society name and description.
//- 2. Events table: lists event posts with RSVP counts.
//- 3. Danger Zone: permanently delete the society and all associated data.
extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var societyName = society && society.name ? society.name : "Managed Society";
  - var eventItems = typeof eventItems !== "undefined" ? eventItems : [];
  - var dashboardPath = typeof dashboardPath !== "undefined" ? dashboardPath : "/demo/admin/";

  +pageHeader("Manage Society", "Update the society profile and keep event information organised.", societyName)

  section.section-block
    .dashboard-main
      section.form-shell#society-details
        .section-heading
          p.eyebrow Society Details
          h2 Update the society profile
          p Update your society name and description here.
        if typeof profileUpdated !== "undefined" && profileUpdated
          p.form-success Society details updated successfully.
        form.form-stack(method="post", action="/admin/manage-society/update")
          +formInput("society-name", "Society Name", "text", "Enter the society name", societyName, "name")
          +formTextarea("society-description", "Society Description", "Write the society description", society && society.about_us_text ? society.about_us_text : "", "about_us_text")
          .btn-row
            button.btn.btn-primary(type="submit") Update

      section.section-card#events
        .section-heading
          p.eyebrow Events
          h2 Events connected to the society
          p All events created for this society, along with their current RSVP counts.
        if eventItems.length
          .data-table.events-table
            .data-row.data-row-header
              span Title
              span Date Created
              span
            each item in eventItems
              .data-row
                span= item.title
                span= item.created_at
                span.events-table-rsvp= item.rsvp_count + " RSVP" + (item.rsvp_count === 1 ? "" : "s")
        else
          +emptyState("No events yet", "Event records will appear here once society events are available.")

      section.section-card.danger-zone#danger-zone
        .section-heading
          p.eyebrow Delete Society
          h2 Remove this society
          p Permanently deletes the society and all associated posts, events, and members. This cannot be undone.
        form(method="post", action="/admin/account/delete", onsubmit="return confirm('Are you sure you want to delete this society? This cannot be undone.')")
          button.btn.btn-danger(type="submit") Delete Society
