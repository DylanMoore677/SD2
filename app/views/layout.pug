doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Society Hub
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap")
    link(rel="stylesheet", href="/style.css")
  body
    .page-shell.site-shell
      header.site-header
        .page-container
          nav.navbar(aria-label="Primary navigation")
            a.logo(href="/") Society Hub
            ul.nav-links
              li: a(href="/") Home
              li: a(href="/preview/societies") Societies
              li: a(href="/preview/profile/1") Profile
              li: a(href="/preview/users") Users
              li: a(href="/login") Login
      main.content
        .page-container.content-stack
          block content
      footer.footer.site-footer
        .page-container
          p Society Hub frontend prototype focused on student and organiser flows.
    script(src="/site.js")
