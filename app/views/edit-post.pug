extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "admin"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Admin"
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Dashboard", href: "/demo/admin/" }, { label: "Manage Society", href: "/demo/admin/manage-society/" }, { label: "Create Post", href: "/demo/admin/create-post/" }, { label: "Members", href: "/demo/admin/members/" }]
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/admin/"

block content
  - var post = typeof post !== "undefined" ? post : {};
  - var updatePath = typeof updatePath !== "undefined" ? updatePath : "#";
  - var cancelPath = typeof cancelPath !== "undefined" ? cancelPath : "/admin/";
  - var postType = post.type ? (post.type.charAt(0).toUpperCase() + post.type.slice(1)) : "Post";

  +pageHeader("Edit Post", "Update the title and content of this " + postType.toLowerCase() + ".", postType)

  section.section-block
    section.form-shell
      .section-heading
        p.eyebrow= postType
        h2 Edit this post

      form.form-stack(method="post", action=updatePath)
        +formInput("edit-title", "Title", "text", "Enter a title...", post.title || "", "title")
        +formTextarea("edit-content", "Content", "Write the content...", post.content || "", "content")
        .btn-row
          button.btn.btn-primary(type="submit") Update
          a.btn.btn-outline(href=cancelPath) Cancel
