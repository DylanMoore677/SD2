extends layout
include includes/ui.pug

block content
  - var memberList = typeof members !== "undefined" ? members : [];
  - var rsvpList = typeof rsvpItems !== "undefined" ? rsvpItems : [];

  +pageHeader("Members and RSVP Management", "Review society members and event attendance in one organised admin view with a clear information hierarchy.", "Admin / Organiser")
    a.btn.btn-primary(href="/preview/users") Open Member Directory
    a.btn.btn-outline(href="/login") Back to Dashboard

  section.section-block
    +dashboardLayout()
      +dashboardSidebar("Members / RSVP Navigation", "Keep the attendance and member-management side of the organiser flow grouped into one readable admin page.")
        +dashboardNav([
          { label: "Members", href: "#member-list", active: true },
          { label: "RSVPs", href: "#rsvp-list" },
          { label: "Workflow", href: "#workflow" }
        ])
        +statsGrid
          +statCard(memberList.length, "Members", "See the current member count in the same page as RSVP review.")
          +statCard(rsvpList.length, "RSVPs", "Attendance responses can be monitored alongside member management.")

      main.dashboard-main
        section.section-card#member-list
          .section-heading
            p.eyebrow Member List
            h2 Society members
            p Keep the member list structured and easy to scan.
          if memberList.length
            .data-table
              .data-row.data-row-header
                span Name
                span Student ID
                span Email
                span Actions
              each member in memberList
                .data-row
                  span #{member.first_name} #{member.last_name}
                  span= member.student_id
                  span= member.email
                  .btn-row
                    a.btn.btn-outline(href="/preview/profile/" + member.student_id) View Profile
          else
            +emptyState("No members to show yet", "Member records will appear here once they are passed into the admin template.")

        section.section-card#rsvp-list
          .section-heading
            p.eyebrow RSVP List
            h2 Event attendance overview
            p Review RSVP information with the same organised layout used for member records.
          if rsvpList.length
            .data-table
              .data-row.data-row-header
                span Student
                span Event
                span Status
                span Notes
              each item in rsvpList
                .data-row
                  span= item.student_name || "Student attendee"
                  span= item.event_name || "Event"
                  span= item.status || "RSVP recorded"
                  span= item.note || "No extra notes"
          else
            +emptyState("No RSVP records to show yet", "Attendance information will appear here once RSVP data is available in the organiser template.")

        section.section-card#workflow
          .section-heading
            p.eyebrow Workflow
            h2 Keep the information hierarchy clear
            p This layout keeps member records and attendance review separate but easy to navigate from the same admin page.
          +cardGrid(2)
            +sharedCard("management-card", "Members", "Review the member list first", "Start by checking who belongs to the society before moving into event attendance and follow-up.")
            +sharedCard("management-card", "RSVPs", "Use attendance records for planning", "Keep RSVP information structured so organisers can plan event capacity and follow-up clearly.")
