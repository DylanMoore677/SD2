extends layout

block content
  //- Login page wraps both student and admin entry points inside a single card layout.
  div.profile-container
    h1 Login to Society Hub

    //- These buttons act as visual role choices before full authentication logic is connected.
    div
      p Who are you logging in as?
      a.btn(href="#") Student Login
      a.btn(href="#") Admin Login

    br

    //- Student form collects the basic credentials needed for a standard member sign-in flow.
    div
      h2 Student Login
      form
        div
          label Email
          input(type="email", placeholder="Enter your university email")
        div
          label Password
          input(type="password", placeholder="Enter your password")
        button.btn Login
        p Don't have an account?
          a(href="#") Register here

    br

    //- Admin form mirrors the student form but keeps the admin journey visually separate.
    div
      h2 Admin Login
      form
        div
          label Email
          input(type="email", placeholder="Enter admin email")
        div
          label Password
          input(type="password", placeholder="Enter your password")
        button.btn Login as Admin
