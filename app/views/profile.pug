extends layout
include includes/ui.pug

mixin profileIcon(name)
  case name
    when "avatar"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        circle(cx="12", cy="8", r="3.6")
        path(d="M6 19v-1.3a6 6 0 0 1 6-6h0a6 6 0 0 1 6 6V19")
    when "user"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        circle(cx="12", cy="8", r="3.1")
        path(d="M7.5 18.2a4.8 4.8 0 0 1 9 0")
    when "id"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        rect(x="4.5", y="6", width="15", height="12", rx="2")
        circle(cx="9", cy="12", r="1.25")
        path(d="M12 10.2h4.2")
        path(d="M12 13.8h4.2")
    when "mail"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        rect(x="4.5", y="6.5", width="15", height="11", rx="2")
        path(d="M5.5 8l6.5 5 6.5-5")
    when "calendar"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        rect(x="4.5", y="6.5", width="15", height="12", rx="2")
        path(d="M8 4.8v3.2")
        path(d="M16 4.8v3.2")
        path(d="M4.5 10h15")
    when "members"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        circle(cx="9", cy="8.5", r="2.6")
        circle(cx="16.5", cy="10", r="2.1")
        path(d="M4.8 18.5v-1a4.3 4.3 0 0 1 8.6 0v1")
        path(d="M14.2 18v-.6a3.4 3.4 0 0 1 4.8-3.1")
    when "event"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        rect(x="4.5", y="6.5", width="15", height="12", rx="2")
        path(d="M8 4.8v3.2")
        path(d="M16 4.8v3.2")
        path(d="M4.5 10h15")
        path(d="M9 13h2.5")
    when "updates"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M12 5.5a4.1 4.1 0 0 1 4.1 4.1v2.1l1.4 2.5H6.5l1.4-2.5V9.6A4.1 4.1 0 0 1 12 5.5z")
        path(d="M10.1 17.2a2.1 2.1 0 0 0 3.8 0")
    when "edit"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M4.8 19.2l3.2-.7L18 8.5l-2.8-2.8L5.2 15.7z")
        path(d="M13.8 6.9l2.8 2.8")
    when "plus"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M12 6v12")
        path(d="M6 12h12")
    when "logout"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M10 6H7.5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2H10")
        path(d="M14 8l4 4-4 4")
        path(d="M18 12H9.5")
    when "delete"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M6.5 7.5h11")
        path(d="M9 7.5V5.8h6v1.7")
        path(d="M8 7.5l.8 10.2h6.4L16 7.5")
        path(d="M10.5 10.2v4.4")
        path(d="M13.5 10.2v4.4")
    when "arrow"
      svg.student-profile-svg(viewBox="0 0 24 24" aria-hidden="true")
        path(d="M7 12h10")
        path(d="M13.5 8.5l3.5 3.5-3.5 3.5")

block pageVars
  - var pageRole = "student"
  - var headerRoleLabel = typeof headerRoleLabel !== "undefined" ? headerRoleLabel : "Student"
  - var logoPath = typeof logoPath !== "undefined" ? logoPath : "/demo/student/"
  - var studentBasePath = logoPath.replace(/\/$/, "")
  - var navLinks = typeof navLinks !== "undefined" ? navLinks : [{ label: "Home", href: studentBasePath + "/", exact: true }, { label: "Societies", href: studentBasePath + "/societies/" }, { label: "News", href: studentBasePath + "/feed/" }, { label: "Profile", href: studentBasePath + "/profile/1/", icon: "profile" }]

block content
  - var isGuest = typeof isGuest !== "undefined" ? isGuest : false;
  - var fullName = [user && user.first_name, user && user.last_name].filter(Boolean).join(" ");
  - var displayName = fullName || (isGuest ? "Guest User" : "Student Name");
  - var displayEmail = user && user.email ? user.email : (isGuest ? "guest@preview" : "Not available");
  - var joinedSocieties = user && user.joined_societies ? user.joined_societies : [];
  - var browsePath = typeof browsePath !== "undefined" ? browsePath : studentBasePath + "/societies/";
  - var loginPath = typeof loginPath !== "undefined" ? loginPath : "/login";
  - var registerPath = typeof registerPath !== "undefined" ? registerPath : "/register/";
  - var memberSince = typeof memberSince !== "undefined" ? memberSince : (isGuest ? "Guest access" : "May 2025");
  - var joinedCount = joinedSocieties.length;
  - var upcomingEventsCount = typeof upcomingEventsCount !== "undefined" ? upcomingEventsCount : (isGuest ? 0 : Math.max(joinedCount + 2, joinedCount ? 3 : 0));
  - var recentUpdatesCount = typeof recentUpdatesCount !== "undefined" ? recentUpdatesCount : (isGuest ? 0 : Math.max(joinedCount + 3, joinedCount ? 4 : 0));
  - var activityItems = [{ icon: "members", value: joinedCount, label: "Joined Societies" }, { icon: "event", value: upcomingEventsCount, label: "Upcoming Events" }, { icon: "updates", value: recentUpdatesCount, label: "Recent Updates" }];
  - var societyObjects = typeof joinedSocietyObjects !== "undefined" ? joinedSocietyObjects : [];
  - var joinedCommunities = societyObjects.map(function(s) { return { name: s.name || "Society", id: s.society_id, badge: "Member" }; });

  header.page-header.student-profile-header
    .student-profile-header-copy
      h1.page-title My Profile
      p.page-subtitle Manage your account details, view your joined societies, and update your preferences.
    .student-profile-hero-avatar(aria-hidden="true")
      span.student-profile-hero-avatar-circle
        +profileIcon("avatar")

  section.section-block.student-profile-section.student-profile-overview-section
    .student-profile-main-grid
      section.section-card.student-profile-summary-card
        p.student-profile-kicker Profile Summary
        h2.card-title Your details
        .student-profile-detail-list
          .student-profile-detail-row
            span.student-profile-detail-icon
              +profileIcon("user")
            span.student-profile-detail-label Full Name
            strong.student-profile-detail-value= displayName
          .student-profile-detail-row
            span.student-profile-detail-icon
              +profileIcon("mail")
            span.student-profile-detail-label Email Address
            strong.student-profile-detail-value= displayEmail
          .student-profile-detail-row
            span.student-profile-detail-icon
              +profileIcon("calendar")
            span.student-profile-detail-label Member Since
            strong.student-profile-detail-value= memberSince
        .btn-row.student-profile-summary-actions
          if isGuest
            a.btn.btn-primary.student-profile-inline-button(href=registerPath)
              span.student-profile-button-icon
                +profileIcon("plus")
              span Register
            a.btn.btn-outline.student-profile-inline-button(href=loginPath) Login
          else
            button.btn.btn-outline.student-profile-inline-button(type="button")
              span.student-profile-button-icon
                +profileIcon("edit")
              span Edit Profile

      aside.section-card.student-profile-activity-card
        h2.card-title Your Activity
        .student-profile-activity-list
          each item in activityItems
            .student-profile-activity-item
              span.student-profile-activity-icon(class="is-" + item.icon)
                +profileIcon(item.icon)
              .student-profile-activity-copy
                strong= item.value
                span= item.label

  section.section-block.student-profile-section
    section.section-card.student-profile-communities-card
      h2.card-title Your Communities
      p.card-text The societies you've joined.
      if joinedCommunities.length
        .student-profile-community-list
          each community in joinedCommunities
            article.student-profile-community-item
              .student-profile-community-body
                h3.student-profile-community-title= community.name
                span.student-profile-community-badge= community.badge
              if community.id
                a.btn.btn-outline.student-profile-community-link(href=studentBasePath + "/societies/" + community.id + "/")
                  span View Society
                  span.student-profile-button-icon
                    +profileIcon("arrow")
              else
                a.btn.btn-outline.student-profile-community-link(href=browsePath)
                  span Browse Societies
                  span.student-profile-button-icon
                    +profileIcon("arrow")
      else
        p.empty-copy.student-profile-empty-copy #{isGuest ? "Guest browsing does not save societies yet, but you can still explore everything." : "Joined societies will appear here once membership data is available."}
      a.btn.btn-outline.student-profile-wide-action(href=browsePath)
        span.student-profile-button-icon
          +profileIcon("plus")
        span Join More Societies

  section.section-block.student-profile-section
    section.section-card.student-profile-actions-card
      p.student-profile-kicker Account Actions
      h2.card-title #{isGuest ? "Ready to create an account?" : "Manage your account"}
      p.card-text #{isGuest ? "Create an account to save societies, personalise your feed, and manage your student space." : "Log out of your account or permanently delete it."}
      .btn-row.student-profile-account-buttons
        if isGuest
          a.btn.btn-primary.student-profile-inline-button(href=registerPath)
            span.student-profile-button-icon
              +profileIcon("plus")
            span Register
          a.btn.btn-outline.student-profile-inline-button(href=loginPath) Login
        else
          button.btn.btn-outline.student-profile-inline-button(type="button")
            span.student-profile-button-icon
              +profileIcon("logout")
            span Logout
          form(method="post", action=studentBasePath + "/account/delete", onsubmit="return confirm('Are you sure? This cannot be undone.')")
            button.btn.btn-danger.student-profile-inline-button.student-profile-delete-button(type="submit")
              span.student-profile-button-icon
                +profileIcon("delete")
              span Delete Account
