//- Landing page shown at "/" when no session exists.
//- Reuses the authLoginEntry mixin so it is visually identical to login.pug.
extends layout
include includes/ui.pug

block pageVars
  - var pageRole = "student"
  - var headerRoleLabel = null
  - var navLinks = []
  - var logoPath = "/"

block content
  //- Resolve path variables with safe fallbacks for demo/static preview contexts
  - var registerPath = typeof registerPath !== "undefined" ? registerPath : "/register/"
  - var guestPath = typeof guestPath !== "undefined" ? guestPath : "/demo/guest/"
  - var studentHomePath = typeof studentHomePath !== "undefined" ? studentHomePath : "/demo/student/"
  - var adminHomePath = typeof adminHomePath !== "undefined" ? adminHomePath : "/demo/admin/"
  - var adminRegisterPath = typeof adminRegisterPath !== "undefined" ? adminRegisterPath : "/register/admin/"

  +authLoginEntry(studentHomePath, adminHomePath, guestPath, registerPath, adminRegisterPath, "student")
